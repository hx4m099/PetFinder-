@model PetFinder.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container py-5">
    <div class="pf-form-card">
        <div class="text-center mb-4">
            <div style="font-size:3rem">🐾</div>
            <h1 class="pf-form-title">Bienvenido de vuelta</h1>
            <p class="text-muted">Inicia sesión para continuar</p>
        </div>

        <form asp-action="Login" method="post" id="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" placeholder="tu@correo.com"
                       autocomplete="email" id="email-input" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" placeholder="Contraseña"
                           autocomplete="current-password" id="password-input" />
                    <button class="btn btn-outline-secondary" type="button" id="toggle-pwd"
                            aria-label="Mostrar contraseña">
                        <i class="bi bi-eye" id="pwd-icon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <button type="submit" class="pf-btn-primary w-100 mb-3" id="login-btn">
                <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
            </button>
        </form>

        <div class="text-center text-muted small">
            ¿No tienes cuenta? 
            <a asp-action="Registro" class="fw-bold" style="color:var(--pf-orange)">Regístrate gratis</a>
        </div>

        <!-- Accesos rápidos de demo -->
        <hr class="my-4">
        <p class="text-center text-muted small mb-2">Accesos rápidos de demostración:</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <button class="btn btn-sm btn-outline-secondary pf-demo-btn"
                    data-email="admin@petfinder.mx" data-pwd="Admin12345">
                👑 Admin
            </button>
            <button class="btn btn-sm btn-outline-secondary pf-demo-btn"
                    data-email="refugio@patitasfelices.mx" data-pwd="Refugio12345">
                🏠 Refugio
            </button>
            <button class="btn btn-sm btn-outline-secondary pf-demo-btn"
                    data-email="ana@gmail.com" data-pwd="Adoptante12345">
                🐾 Adoptante
            </button>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Toggle password visibility
        document.getElementById('toggle-pwd').addEventListener('click', () => {
            const input = document.getElementById('password-input');
            const icon  = document.getElementById('pwd-icon');
            if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
            else { input.type = 'password'; icon.className = 'bi bi-eye'; }
        });

        // Demo buttons
        document.querySelectorAll('.pf-demo-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('email-input').value = btn.dataset.email;
                document.getElementById('password-input').value = btn.dataset.pwd;
            });
        });
    </script>
}
