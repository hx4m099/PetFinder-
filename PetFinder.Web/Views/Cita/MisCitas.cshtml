@model PetFinder.Web.ViewModels.MisCitasViewModel
@{
    ViewData["Title"] = "Mis citas";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4"><i class="bi bi-calendar-heart text-danger me-2"></i>Mis citas</h1>

    @if (!Model.Pendientes.Any() && !Model.Confirmadas.Any() && !Model.Historial.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:5rem">📅</div>
            <h3 class="text-muted mt-3">No tienes citas agendadas</h3>
            <a asp-controller="Adopcion" asp-action="Catalogo" class="pf-btn-primary mt-3">
                Ver mascotas disponibles
            </a>
        </div>
    }
    else
    {
        <!-- Pendientes -->
        @if (Model.Pendientes.Any())
        {
            <h2 class="h5 fw-bold mb-3 text-warning">⏳ Pendientes</h2>
            <div class="row g-3 mb-4">
                @foreach (var c in Model.Pendientes) { @await Html.PartialAsync("_CitaCard", c) }
            </div>
        }

        <!-- Confirmadas -->
        @if (Model.Confirmadas.Any())
        {
            <h2 class="h5 fw-bold mb-3 text-success">✅ Confirmadas</h2>
            <div class="row g-3 mb-4">
                @foreach (var c in Model.Confirmadas) { @await Html.PartialAsync("_CitaCard", c) }
            </div>
        }

        <!-- Historial -->
        @if (Model.Historial.Any())
        {
            <h2 class="h5 fw-bold mb-3 text-muted">🗂️ Historial</h2>
            <div class="row g-3">
                @foreach (var c in Model.Historial) { @await Html.PartialAsync("_CitaCard", c) }
            </div>
        }
    }
</div>
