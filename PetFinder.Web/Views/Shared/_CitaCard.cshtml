@model BLL.Dtos.CitaDto
@{
    var estadoClass = Model.Estado switch {
        ENTITY.Enums.EstadoCita.Pendiente  => "badge-pendiente",
        ENTITY.Enums.EstadoCita.Confirmada => "badge-confirmada",
        ENTITY.Enums.EstadoCita.Cancelada  => "badge-cancelada",
        _                                  => "badge-completada"
    };
    var estadoIcon = Model.Estado switch {
        ENTITY.Enums.EstadoCita.Pendiente  => "⏳",
        ENTITY.Enums.EstadoCita.Confirmada => "✅",
        ENTITY.Enums.EstadoCita.Cancelada  => "❌",
        _                                  => "🎉"
    };
}

<div class="col-md-6 col-lg-4">
    <div class="pf-card h-100">
        <div class="pf-card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h3 class="h6 fw-bold mb-0">@Model.NombreMascota</h3>
                    <p class="text-muted small mb-0">@Model.NombreRefugio · @Model.CiudadRefugio</p>
                </div>
                <span class="badge @estadoClass">@estadoIcon @Model.Estado</span>
            </div>

            <p class="fw-semibold mb-1">
                <i class="bi bi-calendar text-muted me-1"></i>
                @Model.FechaHora.ToString("dddd, dd/MM/yyyy 'a las' HH:mm")
            </p>

            @if (!string.IsNullOrEmpty(Model.NotasAdoptante))
            {
                <p class="text-muted small mb-1">
                    <i class="bi bi-chat-left-text me-1"></i>@Model.NotasAdoptante
                </p>
            }
            @if (!string.IsNullOrEmpty(Model.NotasRefugio))
            {
                <div class="alert alert-info small py-2 mb-2">
                    <i class="bi bi-info-circle me-1"></i><strong>Refugio:</strong> @Model.NotasRefugio
                </div>
            }

            @if (Model.Estado == ENTITY.Enums.EstadoCita.Pendiente ||
                 Model.Estado == ENTITY.Enums.EstadoCita.Confirmada)
            {
                <form asp-controller="Cita" asp-action="Cancelar" method="post" class="mt-3"
                      onsubmit="return confirm('¿Seguro que deseas cancelar esta cita?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                        <i class="bi bi-x-circle me-1"></i>Cancelar cita
                    </button>
                </form>
            }
        </div>
    </div>
</div>
