@* PetFinder.Web/Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PetFinder - Plataforma comunitaria para encontrar mascotas perdidas y conectar con refugios aliados para adopción responsable." />
    <title>@ViewData["Title"] — PetFinder 🐾</title>

    <!-- Google Fonts: Fraunces (Serif elegante) y DM Sans (Sans-serif moderno) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,600&family=Nunito:wght@400;600;700;800&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap & Iconos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Leaflet CSS para el mapa interactivo -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Estilos de PetFinder -->
    <link rel="stylesheet" href="~/css/petfinder.css" asp-append-version="true" />

    <!-- Detección de JS para Progressive Enhancement -->
    <script>document.documentElement.classList.add('js-enabled');</script>

    <!-- Import Map de Three.js -->
    <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/"
      }
    }
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Barra de progreso de lectura en scroll -->
    <div id="scroll-progress" class="scroll-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"></div>

    <!-- ── Navbar ──────────────────────────────────────────────────────────────── -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg pf-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand pf-brand" asp-controller="Home" asp-action="Index">
                    <span class="pf-paw">🐾</span> PetFinder
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-label="Menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Adopcion" asp-action="Catalogo">
                                <i class="bi bi-heart-fill text-danger me-1"></i>Adoptar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#refugios">Refugios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#comunidad">Comunidad</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#faq">Preguntas</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reporte" asp-action="Crear">
                                    <i class="bi bi-search-heart me-1"></i>Reportar mascota
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Refugio"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Refugio" asp-action="Panel">
                                        <i class="bi bi-house-heart"></i> Mi Refugio
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Panel">
                                        <i class="bi bi-shield-check"></i> Admin
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cita" asp-action="MisCitas">
                                    <i class="bi bi-calendar-heart"></i> Mis citas
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle pf-user-pill" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    @User.FindFirst(ENTITY.Constants.PetFinderConstants.ClaimNombre)?.Value
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Reporte" asp-action="MisReportes">
                                        <i class="bi bi-list-ul"></i> Mis reportes
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn pf-btn-outline btn-sm" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn pf-btn-primary btn-sm" asp-controller="Auth" asp-action="Registro">
                                    Registrarse
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ── Alertas globales ───────────────────────────────────────────────────── -->
    <div class="container global-alert-container">
        @if (TempData["Success"] != null)
        {
            <div class="alert pf-alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- ── Contenido principal ────────────────────────────────────────────────── -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Botón Flotante Volver Arriba -->
    <button id="back-to-top" class="pf-back-to-top" aria-label="Volver arriba">
        <i class="bi bi-arrow-up"></i>
    </button>

    <!-- ── Footer Completo ─────────────────────────────────────────────────────── -->
    <footer class="pf-footer-extended">
        <div class="container py-6">
            <div class="row g-4 justify-content-between">
                <!-- Columna 1: Marca y Propósito -->
                <div class="col-lg-4">
                    <a class="pf-brand fs-4 mb-2 d-inline-block text-decoration-none" asp-controller="Home" asp-action="Index">
                        <span class="pf-paw">🐾</span> PetFinder
                    </a>
                    <p class="footer-desc mt-2">
                        Red comunitaria para el reencuentro de mascotas perdidas y adopción responsable en alianza con los mejores refugios certificados de México.
                    </p>
                    <div class="footer-social-links d-flex gap-2 mt-3">
                        <a href="#" class="social-icon" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-icon" aria-label="GitHub"><i class="bi bi-github"></i></a>
                    </div>
                </div>

                <!-- Columna 2: Enlaces Rápidos -->
                <div class="col-6 col-md-3 col-lg-2">
                    <h5 class="footer-col-title">Plataforma</h5>
                    <ul class="footer-nav-list">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Adopcion" asp-action="Catalogo">Catálogo de adopción</a></li>
                        <li><a href="#refugios">Refugios aliados</a></li>
                        <li><a href="#comunidad">Tablero de búsqueda</a></li>
                        <li><a href="#faq">Preguntas frecuentes</a></li>
                    </ul>
                </div>

                <!-- Columna 3: Refugios & Aliados -->
                <div class="col-6 col-md-3 col-lg-2">
                    <h5 class="footer-col-title">Comunidad</h5>
                    <ul class="footer-nav-list">
                        <li><a asp-controller="Auth" asp-action="Registro">Registrar refugio</a></li>
                        <li><a asp-controller="Reporte" asp-action="Crear">Reportar extravío</a></li>
                        <li><a href="#pasos">Protocolo de rescate</a></li>
                        <li><a href="#historias">Casos de éxito</a></li>
                    </ul>
                </div>

                <!-- Columna 4: Contacto & Compromiso -->
                <div class="col-md-6 col-lg-3">
                    <h5 class="footer-col-title">Atención & Ayuda</h5>
                    <p class="footer-contact-item"><i class="bi bi-geo-alt me-2 text-warning"></i>Valledupar, Cesar, Colombia</p>
                    <p class="footer-contact-item"><i class="bi bi-envelope me-2 text-warning"></i>contacto@petfinder.org</p>
                    <p class="footer-contact-item"><i class="bi bi-clock me-2 text-warning"></i>Monitoreo comunitario 24/7</p>
                    <div class="footer-pledge mt-3">
                        <small>🛡️ Comprometidos con el bienestar animal y adopciones sin fines de lucro.</small>
                    </div>
                </div>
            </div>

            <hr class="footer-divider my-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-muted small">
                <span>&copy; @DateTime.Now.Year PetFinder. Hecho con ❤️ para cada huella.</span>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="footer-legal-link">Privacidad</a>
                    <span>·</span>
                    <a href="#" class="footer-legal-link">Términos de servicio</a>
                    <span>·</span>
                    <a href="#" class="footer-legal-link">Contacto</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
