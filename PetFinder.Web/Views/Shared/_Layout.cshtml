<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PetFinder - Encuentra mascotas perdidas y adopta con refugios aliados" />
    <title>@ViewData["Title"] — PetFinder 🐾</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/petfinder.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ── Navbar ──────────────────────────────────────────────────────────────── -->
<nav class="navbar navbar-expand-lg pf-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand pf-brand" asp-controller="Home" asp-action="Index">
            <span class="pf-paw">🐾</span> PetFinder
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Adopcion" asp-action="Catalogo">
                        <i class="bi bi-heart-fill text-danger"></i> Adoptar
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reporte" asp-action="Crear">
                            <i class="bi bi-search-heart"></i> Reportar mascota
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Refugio"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Refugio" asp-action="Panel">
                                <i class="bi bi-house-heart"></i> Mi Refugio
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Panel">
                                <i class="bi bi-shield-check"></i> Admin
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cita" asp-action="MisCitas">
                            <i class="bi bi-calendar-heart"></i> Mis citas
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle pf-user-pill" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i>
                            @User.FindFirst(ENTITY.Constants.PetFinderConstants.ClaimNombre)?.Value
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Reporte" asp-action="MisReportes">
                                <i class="bi bi-list-ul"></i> Mis reportes
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn pf-btn-outline btn-sm" asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn pf-btn-primary btn-sm" asp-controller="Auth" asp-action="Registro">
                            Registrarse
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- ── Alertas globales ───────────────────────────────────────────────────── -->
<div class="container mt-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert pf-alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

<!-- ── Contenido principal ────────────────────────────────────────────────── -->
<main role="main">
    @RenderBody()
</main>

<!-- ── Footer ─────────────────────────────────────────────────────────────── -->
<footer class="pf-footer mt-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                <span class="pf-brand fs-5">🐾 PetFinder</span>
                <p class="text-muted small mt-1 mb-0">Conectando mascotas con familias amorosas.</p>
            </div>
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <a asp-controller="Adopcion" asp-action="Catalogo" class="pf-footer-link">Adoptar</a>
                <span class="text-muted mx-2">·</span>
                <a asp-controller="Reporte" asp-action="Crear" class="pf-footer-link">Reportar</a>
            </div>
            <div class="col-md-4 text-center text-md-end">
                <small class="text-muted">© @DateTime.Now.Year PetFinder · Todos los derechos reservados</small>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
