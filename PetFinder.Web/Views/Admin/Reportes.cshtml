@model IEnumerable<BLL.Dtos.ReporteResumenDto>
@{
    ViewData["Title"] = "Gestión de Reportes — Admin";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">📋 Reportes de mascotas</h1>
            <p class="text-muted mb-0">Casos activos reportados por la comunidad en Valledupar, Cesar.</p>
        </div>
        <a asp-action="Panel" class="btn pf-btn-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver al Panel
        </a>
    </div>

    <div class="pf-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Foto</th>
                        <th>Tipo</th>
                        <th>Mascota / Especie</th>
                        <th>Ubicación</th>
                        <th>Fecha</th>
                        <th>Reportado por</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td style="width: 60px;">
                                <img src="@(string.IsNullOrEmpty(r.FotoUrl) ? "/images/placeholder-pet.svg" : r.FotoUrl)"
                                     alt="Foto"
                                     class="rounded-circle"
                                     style="width: 48px; height: 48px; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='/images/placeholder-pet.svg';">
                            </td>
                            <td>
                                @if (r.TipoReporte == ENTITY.Enums.TipoReporte.Perdida)
                                {
                                    <span class="badge bg-danger">Perdida</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Encontrada</span>
                                }
                            </td>
                            <td>
                                <strong>@(string.IsNullOrEmpty(r.NombreMascota) ? "Sin nombre" : r.NombreMascota)</strong>
                                <br><small class="text-muted">@r.Especie</small>
                            </td>
                            <td>@r.Ciudad</td>
                            <td><small>@r.FechaReporte.ToString("dd/MM/yyyy")</small></td>
                            <td>@r.NombreUsuario</td>
                            <td class="text-end">
                                <a asp-controller="Reporte" asp-action="Detalle" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
