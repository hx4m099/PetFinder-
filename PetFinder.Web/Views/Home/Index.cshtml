@* PetFinder.Web/Views/Home/Index.cshtml *@
@model PetFinder.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ── Hero Section con Cachorro Chibi 3D Interactivo ───────────────────────── -->
<section class="pf-hero hero-section" id="hero-section" aria-label="Sección principal">
    <div class="container position-relative">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6" data-reveal="fade-right">
                <div class="pf-hero-badge">
                    <span>🐾</span> +200 mascotas rescatadas este año
                </div>
                <h1 class="pf-hero-title">
                    Cada mascota merece un<br>
                    <span class="highlight">hogar lleno de amor</span>
                </h1>
                <p class="pf-hero-subtitle">
                    Reporta mascotas perdidas, encuentra coincidencias con fotos y 
                    conecta con refugios aliados para adoptar. Todo en un solo lugar.
                </p>
                <div class="pf-hero-actions d-flex flex-wrap gap-3">
                    <a asp-controller="Adopcion" asp-action="Catalogo" class="pf-btn-primary">
                        <i class="bi bi-heart-fill me-2"></i>Adoptar ahora
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Reporte" asp-action="Crear" class="pf-btn-outline">
                            <i class="bi bi-search me-2"></i>Reportar mascota
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Registro" class="pf-btn-outline">
                            <i class="bi bi-person-plus me-2"></i>Comenzar gratis
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 d-flex justify-content-center align-items-center" data-reveal="fade-left">
                <div class="pf-hero-canvas-container" id="hero-canvas-container">
                    <canvas id="hero-canvas" aria-label="Perrito 3D interactivo"></canvas>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 1. Cifras de Impacto (Contadores animados por scroll) -->
@await Html.PartialAsync("_StatsSection", Model.Estadisticas)

<!-- 2. Cómo Funciona (3 pasos con línea discontinua animada) -->
@await Html.PartialAsync("_PasosSection")

<!-- 3. Red de Refugios (Mapa interactivo Leaflet y lista sincronizada) -->
@await Html.PartialAsync("_MapaRefugios", Model)

<!-- 4. Mascotas Destacadas (Catálogo con efecto 3D tilt y enlace de adopción) -->
@await Html.PartialAsync("_MascotasDestacadas", Model.MascotasDestacadas)

<!-- 5. Tablero Comunitario (Fondo oscuro #4A3728 y alertas de búsqueda) -->
@await Html.PartialAsync("_TableroComunitario", Model.AvisosRecientes)

<!-- 6. Historias de Reencuentro (Testimonios y experiencias comunitarias) -->
@await Html.PartialAsync("_HistoriasSection")

<!-- 7. Preguntas Frecuentes (Acordeón accesible) -->
@await Html.PartialAsync("_FaqSection")

<!-- 8. Llamada a la Acción Final -->
@await Html.PartialAsync("_CtaSection")

@section Scripts {
    <!-- Cachorro Chibi 3D en Three.js -->
    <script type="module" src="~/js/three/landing-scene.js"></script>

    <!-- Mapa Interactivo de Refugios en Leaflet -->
    <script src="~/js/map/refugios-map.js"></script>

    <!-- Módulo Central de Animaciones de Scroll y Micro-interacciones -->
    <script type="module" src="~/js/scroll/main.js"></script>
}
