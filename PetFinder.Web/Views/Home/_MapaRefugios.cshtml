@* PetFinder.Web/Views/Home/_MapaRefugios.cshtml *@
@model PetFinder.Web.Models.HomeViewModel

<section id="refugios" class="mapa-section py-6 bg-cream-soft position-relative" aria-labelledby="mapa-title">
    <div class="container">
        <!-- Encabezado de Sección -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end mb-4" data-reveal="fade-up">
            <div>
                <span class="section-tag">RED DE REFUGIOS ASOCIADOS</span>
                <h2 id="mapa-title" class="section-title-serif mt-2">
                    Encuentra el refugio <span class="highlight-serif">más cercano a ti</span>
                </h2>
                <p class="section-subtitle mb-0">
                    Explora nuestra red de espacios dedicados al rescate, cuidado y adopción responsable.
                </p>
            </div>
            <div class="mt-3 mt-lg-0">
                <button id="btn-mi-ubicacion" type="button" class="btn btn-geo-locate">
                    <i class="bi bi-crosshair me-2"></i>Usar mi ubicación
                </button>
            </div>
        </div>

        <!-- Barra de Filtros -->
        <div class="map-filter-bar mb-4 p-3 rounded-4 bg-white shadow-sm" data-reveal="fade-up">
            <div class="row g-3 align-items-center">
                <div class="col-md-6 col-lg-5">
                    <div class="search-input-wrapper">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" id="buscar-refugio-input" class="form-control filter-search-input"
                               placeholder="Buscar por nombre o barrio (ej. Novalito, Los Cortijos)..."
                               aria-label="Buscar refugio">
                    </div>
                </div>
                <div class="col-md-6 col-lg-7 d-flex flex-wrap gap-2 justify-content-md-end">
                    <button type="button" class="btn filter-pill especie-filter-btn active" data-especie="">
                        Todos
                    </button>
                    <button type="button" class="btn filter-pill especie-filter-btn" data-especie="Perro">
                        🐶 Perros
                    </button>
                    <button type="button" class="btn filter-pill especie-filter-btn" data-especie="Gato">
                        🐱 Gatos
                    </button>
                    <button type="button" class="btn filter-pill especie-filter-btn" data-especie="Ave">
                        🦜 Aves
                    </button>
                </div>
            </div>
        </div>

        <!-- Contenedor Dividido: Lista a la Izquierda, Mapa a la Derecha -->
        <div class="map-layout-grid" data-reveal="fade-up">
            <!-- Columna Izquierda: Lista de Refugios con Scroll interno -->
            <div class="refugios-scroll-pane">
                <div id="refugios-lista-dinamica" class="refugios-cards-stack">
                    @foreach (var refugio in Model.Refugios)
                    {
                        <div class="refugio-card-item" data-refugio-id="@refugio.Id" data-lat="@refugio.Latitud" data-lon="@refugio.Longitud">
                            <div class="refugio-card-body">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h4 class="refugio-card-title">@refugio.Nombre</h4>
                                    @if (refugio.DistanciaKm.HasValue)
                                    {
                                        <span class="refugio-distancia-tag"><i class="bi bi-compass"></i> @refugio.DistanciaKm km</span>
                                    }
                                </div>
                                <p class="refugio-card-address"><i class="bi bi-geo-alt"></i> @refugio.Direccion</p>
                                <div class="refugio-card-footer">
                                    <span class="refugio-pets-count"><i class="bi bi-heart-fill text-danger me-1"></i>@refugio.MascotasDisponibles en adopción</span>
                                    <a asp-controller="Adopcion" asp-action="Catalogo" asp-route-refugioId="@refugio.Id" class="refugio-card-link">
                                        Conocer &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Columna Derecha: Mapa Interactivo Leaflet -->
            <div class="map-frame-wrapper position-relative">
                <div id="mapa-refugios-container"
                     class="leaflet-map-surface"
                     data-lat="@Model.MapaConfig.CentroLatitud"
                     data-lon="@Model.MapaConfig.CentroLongitud"
                     data-zoom="@Model.MapaConfig.ZoomInicial"
                     role="application"
                     aria-label="Mapa interactivo de refugios">
                </div>
                <!-- Fallback en caso de que no cargue el script de mapa -->
                <div id="mapa-fallback" class="map-fallback-notice" style="display:none;">
                    <i class="bi bi-map display-4 text-muted mb-2"></i>
                    <p class="mb-0">El mapa interactivo se encuentra temporalmente en mantenimiento. Puedes consultar la lista de refugios a la izquierda.</p>
                </div>
            </div>
        </div>
    </div>
</section>
